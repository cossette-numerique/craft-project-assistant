{% extends '_layouts/cp' %}
{% set title = developer ? 'Developer chat'|t('project-assistant') : assistantName %}
{% set selectedSubnavItem = developer ? 'developer' : 'chat' %}
{% set fullPageForm = false %}
{% set bodyClass = 'pa-page' ~ (developer ? ' pa-page--developer' : '') %}

{% block actionButton %}
    <a class="btn submit add icon" href="{{ cpUrl(newUrl) }}">{{ 'New conversation'|t('project-assistant') }}</a>
{% endblock %}

{% block sidebar %}
    <nav class="pa-history" aria-label="{{ 'Conversations'|t('project-assistant') }}">
        <h2 class="pa-history__heading">{{ 'Your conversations'|t('project-assistant') }}</h2>
        {% if conversations|length %}
            <ul>
                {% for c in conversations %}
                    <li>
                        <a href="{{ cpUrl('project-assistant/c/' ~ c.id) }}" {% if conversation and conversation.id == c.id %}class="sel" aria-current="page"{% endif %}>
                            <span class="pa-history__title">{{ c.title ?: ('Conversation'|t('project-assistant')) }}</span>
                            <span class="pa-history__meta">
                                {{ c.updatedAt|date('short') }}
                                {% if c.ticketReference %}<span class="pa-badge">{{ c.ticketReference }}</span>{% endif %}
                            </span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="light">{{ 'No conversations yet.'|t('project-assistant') }}</p>
        {% endif %}
    </nav>
{% endblock %}

{% block content %}
    {% if not configured %}
        <div class="pa-alert">
            <strong>{{ 'The assistant isn’t configured yet.'|t('project-assistant') }}</strong>
            {{ 'Set the API key (ANTHROPIC_API_KEY) in the environment. See the plugin README.'|t('project-assistant') }}
        </div>
    {% endif %}
    {% if budgetBlock %}
        <div class="pa-alert">{{ budgetBlock }}</div>
    {% endif %}
    {% if developer %}
        <div class="pa-alert pa-alert--developer">
            <strong>{{ 'Developer chat'|t('project-assistant') }}</strong> ·
            {% if not craftToolsAvailable %}
                {{ 'Craft’s MCP tools need Craft 5.12 or later: this chat can only read.'|t('project-assistant') }}
            {% elseif confirmWrites %}
                {{ 'The assistant can change content as you, with your permissions. Every change waits for your approval.'|t('project-assistant') }}
            {% else %}
                {{ 'The assistant can change content as you, with your permissions. Changes run without asking for approval.'|t('project-assistant') }}
            {% endif %}
        </div>
    {% endif %}
    {% if readOnly and owner %}
        <div class="pa-alert pa-alert--info">
            {{ 'You’re viewing a conversation by {name}. It’s read-only.'|t('project-assistant', {name: owner.friendlyName}) }}
        </div>
    {% endif %}

    <div id="pa-chat" class="pa-chat" data-config="{{ config|json_encode|e('html_attr') }}">
        <div class="pa-messages" role="log" aria-live="polite">
            {% if not conversation and developer %}
                <div class="pa-welcome">
                    <h2>{{ 'Developer chat'|t('project-assistant') }}</h2>
                    <p>{{ 'Ask about the project, or ask for content changes. The assistant uses Craft’s own tools as you, and shows each change for approval before it runs.'|t('project-assistant') }}</p>
                    <ul class="pa-examples">
                        <li><button type="button" class="pa-example">{{ 'Which entries have no SEO description?'|t('project-assistant') }}</button></li>
                        <li><button type="button" class="pa-example">{{ 'Create a draft news article titled “Test” in both sites.'|t('project-assistant') }}</button></li>
                    </ul>
                </div>
            {% elseif not conversation %}
                <div class="pa-welcome">
                    <h2>{{ 'Ask anything about your website'|t('project-assistant') }}</h2>
                    <p>{{ 'The assistant can look at your content, how the CMS is set up, and how the site is built. It can’t change anything. If something can’t be done with the CMS, it can prepare a ticket for the development team.'|t('project-assistant') }}</p>
                    <ul class="pa-examples">
                        <li><button type="button" class="pa-example">{{ 'How many events are published this year?'|t('project-assistant') }}</button></li>
                        <li><button type="button" class="pa-example">{{ 'How do I add a new page to the menu?'|t('project-assistant') }}</button></li>
                        <li><button type="button" class="pa-example">{{ 'Can I add a video to a news article?'|t('project-assistant') }}</button></li>
                    </ul>
                </div>
            {% endif %}
        </div>
        {% if not readOnly %}
            <form class="pa-composer" autocomplete="off">
                <label for="pa-input" class="visually-hidden">{{ 'Your question'|t('project-assistant') }}</label>
                <textarea id="pa-input" rows="2" maxlength="8000" placeholder="{{ developer ? 'Ask or request a change…'|t('project-assistant') : 'Ask a question about the website…'|t('project-assistant') }}" {% if not configured or budgetBlock %}disabled{% endif %}></textarea>
                <div class="pa-composer__actions">
                    {% if not developer %}
                        <button type="button" class="btn pa-ticket-btn" {% if not configured or budgetBlock or not conversation %}disabled{% endif %}>{{ 'Create a ticket'|t('project-assistant') }}</button>
                    {% endif %}
                    <button type="submit" class="btn submit" {% if not configured or budgetBlock %}disabled{% endif %}>{{ 'Send'|t('project-assistant') }}</button>
                </div>
                <p class="pa-disclaimer light">{{ 'Answers are generated by AI and can be wrong. Questions and answers are logged.'|t('project-assistant') }}</p>
            </form>
        {% endif %}
    </div>
{% endblock %}
